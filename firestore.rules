rules_version = '2';
// Khedni trial. Paste in Firebase console > Firestore Database > Rules, then Publish.
// Replace ADMIN_PHONE with the admin's number as 961XXXXXXXX. Kept short on purpose:
// pasting more than about 5,000 characters into the console on a phone gets cut off.
service cloud.firestore {
  match /databases/{database}/documents {
    function si() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function adm() { return si() && request.auth.token.email in ['ADMIN_PHONE@phone.khedni.app']; }
    function nd() { return request.resource.data; }
    function od() { return resource.data; }
    function ch() { return nd().diff(od()).affectedKeys(); }
    function g(c, i) { return get(/databases/$(database)/documents/$(c)/$(i)).data; }
    function ride(r) { return g('rides', r); }
    function req(r) { return g('requests', r); }
    function wt(w) { return g('wants', w); }
    function drv() { return si() && g('users', uid()).dstatus == 'active'; }
    function mine() { return od().riderId == uid() || od().driverId == uid(); }
    function pk() { return ['status', 'by', 'updatedAt', 'pu', 'puAt', 'puText', 'price', 'fee', 'km']; }
    function pay() { return nd().price is number && nd().price > 0 && nd().fee is number && nd().fee >= nd().price * 0.09; }

    match /adminping/{id} { allow get: if adm(); }
    match /config/{id} { allow read: if si(); allow write: if adm(); }
    match /users/{id} {
      allow get: if si() && (id == uid() || adm());
      allow list: if adm();
      allow create: if si() && id == uid()
        && nd().keys().hasOnly(['name', 'phone', 'car', 'plate', 'dstatus', 'createdAt'])
        && nd().name is string && nd().name.size() >= 2 && nd().name.size() <= 60
        && request.auth.token.email == nd().phone + '@phone.khedni.app'
        && nd().dstatus in ['none', 'pending'];
      allow update: if adm() || (si() && id == uid() && (ch().hasOnly(['name', 'grp'])
        || (od().dstatus in ['none', 'pending'] && nd().dstatus == 'pending'
          && ch().hasOnly(['name', 'car', 'plate', 'dstatus']))));
    }
    match /rides/{id} {
      allow read: if si();
      allow create: if drv() && nd().driverId == uid() && nd().status == 'open'
        && nd().seats is number && nd().seats >= 1 && nd().seats <= 6
        && nd().seatsLeft == nd().seats && nd().price is number && nd().price > 0;
      allow update: if adm() || (si() && od().driverId == uid()
        && ch().hasOnly(['seatsLeft', 'status', 'poly', 'dur', 'stat', 'dist', 'desc']) && nd().seatsLeft is number
        && nd().seatsLeft >= 0 && nd().seatsLeft <= od().seats);
    }
    match /requests/{id} {
      allow read: if si() && (mine() || adm());
      allow create: if si() && nd().driverId != nd().riderId && pay()
        && ride(nd().rideId).driverId == nd().driverId
        && ride(nd().rideId).status == 'open'
        && ((nd().riderId == uid() && nd().status == 'pending')
          || (nd().driverId == uid() && nd().status == 'offered' && drv()
            && wt(nd().wantId).riderId == nd().riderId && wt(nd().wantId).status == 'open'));
      allow update: if si() && (
        (od().driverId == uid() && od().status == 'pending' && nd().status == 'offered' && drv() && pay() && ch().hasOnly(pk()))
        || (od().riderId == uid() && od().status == 'rerouted' && nd().status == 'pending' && pay()
          && ch().hasOnly(pk().concat(['dr', 'drAt'])))
        || (ch().hasOnly(['status', 'by', 'updatedAt']) && (
          (od().driverId == uid() && (
            (od().status == 'pending' && nd().status == 'rejected')
            || (od().status == 'pending' && nd().status == 'accepted' && drv())
            || (od().status in ['offered', 'accepted', 'rerouted'] && nd().status == 'cancelled')
            || (od().status in ['pending', 'offered', 'accepted'] && nd().status == 'rerouted')))
          || (od().riderId == uid() && (
            (od().status in ['pending', 'offered', 'accepted', 'rerouted'] && nd().status == 'cancelled')
            || (od().status == 'offered' && nd().status == 'accepted'))))));
    }
    match /wants/{id} {
      allow read: if si();
      allow create: if si() && nd().riderId == uid() && nd().status == 'open' && nd().at is number;
      allow update: if si() && od().riderId == uid() && ch().hasOnly(['status'])
        && nd().status in ['matched', 'cancelled'];
    }
    match /docs/{id} {
      allow get: if si() && (id == uid() || adm());
      allow create, update: if si() && id == uid() && !drv() && nd().keys().hasOnly(['id', 'lic', 'car', 'at']);
    }
    match /ratings/{id} {
      allow read: if si();
      allow create: if nd().by == uid() && nd().keys().hasOnly(['by', 'to', 'req', 'stars', 'at'])
        && nd().stars is int && nd().stars >= 1 && nd().stars <= 5 && id == nd().req + '_' + uid()
        && req(nd().req).status == 'accepted'
        && ((req(nd().req).riderId == uid() && nd().to == req(nd().req).driverId)
          || (req(nd().req).driverId == uid() && nd().to == req(nd().req).riderId));
    }
    match /consents/{id} {
      allow get: if si() && (id == uid() || adm());
      allow create, update: if si() && id == uid() && nd().keys().hasOnly(['v', 'at']) && nd().v is number;
    }
    match /photos/{id} {
      allow get: if si();
      allow create, update: if si() && id == uid() && nd().keys().hasOnly(['img', 'at'])
        && nd().img is string && nd().img.size() < 200000;
    }
    match /live/{id} {
      allow get: if si() && (resource == null || od().driverId == uid() || uid() in od().riders || adm());
      allow create: if si() && nd().driverId == uid() && ride(id).driverId == uid();
      allow update: if si() && od().driverId == uid() && nd().driverId == uid();
    }
    match /rlive/{id} {
      allow get: if si() && (resource == null || mine() || adm());
      allow create: if si() && nd().riderId == uid() && req(id).riderId == uid() && req(id).driverId == nd().driverId;
      allow update: if si() && od().riderId == uid() && nd().riderId == uid() && nd().driverId == od().driverId;
    }
    match /chats/{id} {
      allow get: if si() && (resource == null || mine() || adm());
      allow create: if si() && (nd().riderId == uid() || nd().driverId == uid()) && nd().m.size() == 1
        && req(id).riderId == nd().riderId && req(id).driverId == nd().driverId;
      allow update: if si() && mine() && ch().hasOnly(['m'])
        && nd().m.size() == od().m.size() + 1;
    }
    match /payments/{id} {
      allow read: if si() && (od().driverId == uid() || adm());
      allow create: if adm();
    }
  }
}
